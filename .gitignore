# =====================================
# Deep Clean Pro .gitignore
# =====================================
# PowerShell project with Windows optimization tools
# Repository: https://github.com/iSystemDevelopment/deep-clean-pro

# =====================================
# PowerShell Specific
# =====================================

# Backup files generated by DeepCleanPro
Backups/
*Backup/
*.backup
*.bak
*.reg.backup
backup_*.reg

# Log files
Logs/
*.log
*.log.*
DeepClean_*.log
*-log.txt

# Temporary files and cache
Temp/
*Temp/
*.tmp
*.temp
cache/
*Cache/

# PowerShell module cache
PSGetModuleInfo.xml

# PowerShell transcripts
Transcript*.txt
PowerShell_transcript*.txt

# PowerShell profile temp files
*.ps1~
*.psm1~
*.psd1~

# =====================================
# Test Results & Coverage
# =====================================

# Pester test results
TestResults/
*TestResults/
TestResults.xml
*.Tests.Results.xml
testResults.xml
coverage.xml
codecoverage.xml
Pester-*.xml

# Code coverage reports
coverage/
CodeCoverage/
*.coverage
*.coveragexml
coverage*.json
coverage*.html

# =====================================
# Build & Release Artifacts
# =====================================

# Release bundles
*.zip
*.7z
*.rar
*.tar.gz
release/
Release/
dist/
build/
out/
bin/
obj/

# Compiled assemblies (if any)
*.dll
*.exe
*.pdb

# Package artifacts
*.nupkg
*.nuspec

# =====================================
# IDE & Editor Files
# =====================================

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
.vs/
.vscode/

# JetBrains (Rider, IntelliJ, etc.)
.idea/
*.iml
*.iws
.idea_modules/

# PowerShell ISE
*.psess

# Sublime Text
*.sublime-workspace
*.sublime-project

# Atom
.atom/

# Notepad++
nppBackup/

# =====================================
# Windows System Files
# =====================================

# Windows thumbnail cache
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db

# Windows folder config
Desktop.ini
desktop.ini

# Windows shortcuts
*.lnk

# Windows Installer files
*.cab
*.msi
*.msix
*.msm
*.msp

# Windows shortcuts that shouldn't be tracked
*.lnk

# Recycle Bin
$RECYCLE.BIN/

# =====================================
# Secrets & Sensitive Files
# =====================================

# API keys and credentials
*.key
*.secret
*.credentials
*.env
.env
.env.local
.env.*.local
secrets.json
appsettings.local.json

# Certificate files
*.pfx
*.p12
*.cer
*.crt
*.pem

# SSH keys
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.pub

# GPG keys
*.gpg
*.asc

# Configuration overrides (if sensitive)
*config.local.*
*.local.config

# =====================================
# Project-Specific Files
# =====================================

# DeepCleanPro runtime directories
C:/DeepCleanPro/Backups/
C:/DeepCleanPro/Logs/
C:/DeepCleanPro/Temp/

# Deployment artifacts that shouldn't be in repo
DeepClean-Shortcuts.zip
DeepCleanPro-*.zip

# User-specific customization
*custom.ps1
*local.ps1
my*.ps1

# =====================================
# Development & Debugging
# =====================================

# Debug output
debug/
Debug/
*.debug
debug*.txt

# Performance profiling
*.psprofile
*.profile
*.trace

# Experimental scripts
experimental/
sandbox/
scratch/
test-local/

# =====================================
# Documentation Build Artifacts
# =====================================

# Generated documentation (if applicable)
docs/_build/
docs/.doctrees/
site/
_site/
.jekyll-cache/

# =====================================
# Dependency Directories
# =====================================

# Node modules (if used for any tooling)
node_modules/
package-lock.json

# Python virtual environments (if used for any tooling)
venv/
env/
.venv/
__pycache__/
*.pyc

# =====================================
# OS-Specific
# =====================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory
.Trash-*

# =====================================
# Miscellaneous
# =====================================

# Archives and compressed files (general)
*.tgz
*.gz
*.bz2
*.xz

# Temporary file patterns
~$*
*.swp
*.swo
*~

# Patch files
*.patch
*.diff

# Database files
*.db
*.sqlite
*.sqlite3

# =====================================
# Allow Important Files
# =====================================

# Explicitly allow certain files if needed
!.gitignore
!.github/
